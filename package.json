{
  "name": "sheet-plus",
  "type": "module",
  "version": "3.1.0",
  "description": "Create Excel-like spreadsheets and easily embed them in Markdown.",
  "author": "ljcoder",
  "license": "Apache-2.0",
  "keywords": [
    "univer",
    "obsidian",
    "excel",
    "spreadsheet"
  ],
  "engines": {
    "node": ">=20 || <=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "vite build --mode development",
    "build": "vite build",
    "release": "release-it",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:render-visibility": "vitest run tests/render-visibility.test.js",
    "patch-local": "node scripts/patch-local.js"
  },
  "dependencies": {
    "@ljcoder/authorization": "1.10.3",
    "@ljcoder/charts": "1.0.1",
    "@ljcoder/embed-link-ui": "1.10.4",
    "@ljcoder/import-export": "1.10.5",
    "@ljcoder/local-image": "0.1.1",
    "@ljcoder/save": "0.20.1",
    "@ljcoder/sheets-outgoing-link": "1.10.4",
    "@ljcoder/sheets-outgoing-link-ui": "1.10.4",
    "@ljcoder/smart-sheet": "0.0.3",
    "@univerjs/core": "1.1.0",
    "@univerjs/data-validation": "1.1.0",
    "@univerjs/design": "1.1.0",
    "@univerjs/docs": "1.1.0",
    "@univerjs/docs-drawing": "1.1.0",
    "@univerjs/docs-ui": "1.1.0",
    "@univerjs/drawing": "1.1.0",
    "@univerjs/drawing-ui": "1.1.0",
    "@univerjs/engine-formula": "1.1.0",
    "@univerjs/engine-render": "1.1.0",
    "@univerjs/find-replace": "1.1.0",
    "@univerjs/protocol": "1.1.0",
    "@univerjs/sheets": "1.1.0",
    "@univerjs/sheets-conditional-formatting": "1.1.0",
    "@univerjs/sheets-conditional-formatting-ui": "1.1.0",
    "@univerjs/sheets-crosshair-highlight": "1.1.0",
    "@univerjs/sheets-data-validation": "1.1.0",
    "@univerjs/sheets-data-validation-ui": "1.1.0",
    "@univerjs/sheets-drawing": "1.1.0",
    "@univerjs/sheets-drawing-ui": "1.1.0",
    "@univerjs/sheets-filter": "1.1.0",
    "@univerjs/sheets-filter-ui": "1.1.0",
    "@univerjs/sheets-find-replace": "1.1.0",
    "@univerjs/sheets-formula": "1.1.0",
    "@univerjs/sheets-formula-ui": "1.1.0",
    "@univerjs/sheets-hyper-link": "1.1.0",
    "@univerjs/sheets-hyper-link-ui": "1.1.0",
    "@univerjs/sheets-note": "1.1.0",
    "@univerjs/sheets-note-ui": "1.1.0",
    "@univerjs/sheets-numfmt": "1.1.0",
    "@univerjs/sheets-numfmt-ui": "1.1.0",
    "@univerjs/sheets-sort": "1.1.0",
    "@univerjs/sheets-sort-ui": "1.1.0",
    "@univerjs/sheets-table": "1.1.0",
    "@univerjs/sheets-table-ui": "1.1.0",
    "@univerjs/sheets-thread-comment": "1.1.0",
    "@univerjs/sheets-thread-comment-ui": "1.1.0",
    "@univerjs/sheets-ui": "1.1.0",
    "@univerjs/themes": "1.1.0",
    "@univerjs/thread-comment": "1.1.0",
    "@univerjs/thread-comment-ui": "1.1.0",
    "@univerjs/ui": "1.1.0",
    "antd": "6.1.0",
    "antd-style": "3.7.1",
    "monkey-around": "3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "2.27.3",
    "@release-it/conventional-changelog": "8.0.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@univerjs/vite-plugin": "0.5.1",
    "eslint": "8.57.1",
    "obsidian": "1.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "release-it": "17.10.0",
    "rxjs": "7.8.2",
    "simple-git-hooks": "2.11.1",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx eslint --fix --cache && git add -u"
  }
}
